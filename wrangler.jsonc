// Cloudflare Worker that serves the built site as static assets at docs.bitcr.org. Workers Builds
// is connected to the repo: master runs the deploy command. The custom domain and the build
// settings live in the Cloudflare dashboard, not here:
//   build command      pnpm docs:build
//   deploy command     npx wrangler deploy
//   preview command    npx wrangler versions upload (not used, see below)
// "Builds for Preview branches" (Settings > Builds > Previews Base) stays off. With it on, every
// branch build failed at the preview command from 2026-09-29 to 2026-10-09: "The name in your
// wrangler.jsonc file (docs-bitcr) must match the name of your Worker". With it off, a branch push
// starts no build, so a pull request gets no preview URL. Check a change locally instead.
// Node comes from .nvmrc, pnpm from packageManager in package.json; set a PNPM_VERSION build
// variable only if a build log shows a different pnpm than the pinned one.
// Local preview of a build: npx wrangler dev
{
  "name": "docs-bitcr",
  "compatibility_date": "2026-08-31",
  // Each uploaded version gets a preview URL on workers.dev; this is what makes
  // "wrangler versions upload" useful as the preview command.
  "preview_urls": true,
  "assets": {
    // VuePress output, see docs:build in package.json.
    "directory": "./docs/.vuepress/dist",
    // Cloudflare's default. Section indexes such as /e-bill/ serve directly; a page URL such
    // as /glossary.html answers 307 to /glossary and the page is served there. VuePress's
    // router maps the extensionless path back to the .html route, so the app hydrates fine.
    // Serving .html URLs without the redirect would need "none" plus a small Worker script
    // to resolve folder indexes.
    "html_handling": "auto-trailing-slash",
    // VuePress emits 404.html; serve it with a real 404 status for unknown paths.
    "not_found_handling": "404-page"
  }
}
