// Cloudflare Worker that serves the built site as static assets at docs.bitcr.org. Workers Builds
// is connected to the repo: master runs the deploy command. The custom domain and the build
// settings live in the Cloudflare dashboard, not here:
//   build command      pnpm docs:build
//   deploy command     npx wrangler deploy
// Preview builds were last reported disabled on 2026-10-09 in PR #27. While disabled, a branch
// push starts no build and produces no preview or Workers Builds check. The dependency and
// previews block prepare Support's proposal in issue #20; an automatic build must still verify it.
// See README.md for the Worker Previews command and dashboard checks before testing a fresh push.
// Save dashboard changes before pushing the commit that tests the automatic preview trigger.
// Node comes from .nvmrc, pnpm from packageManager in package.json; set a PNPM_VERSION build
// variable only if a build log shows a different pnpm than the pinned one.
// Local preview of a build: pnpm exec wrangler dev
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docs-bitcr",
  "compatibility_date": "2026-08-31",
  // Enable workers.dev preview/version URLs; this does not enable branch build triggers.
  "preview_urls": true,
  // Required for Worker Previews (Wrangler >=4.135.0). This static site has no separate
  // variables or bindings. Assets and compatibility settings stay at the top level.
  "previews": {},
  "assets": {
    // VuePress output, see docs:build in package.json.
    "directory": "./docs/.vuepress/dist",
    // Cloudflare's default. Section indexes such as /e-bill/ serve directly; a page URL such
    // as /glossary.html answers 307 to /glossary and the page is served there. VuePress's
    // router maps the extensionless path back to the .html route, so the app hydrates fine.
    // Serving .html URLs without the redirect would need "none" plus a small Worker script
    // to resolve folder indexes.
    "html_handling": "auto-trailing-slash",
    // VuePress emits 404.html; serve it with a real 404 status for unknown paths.
    "not_found_handling": "404-page"
  }
}
